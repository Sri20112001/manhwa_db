# Base URL for the Pornhwa DB REST API (no trailing slash).
# The API key is NEVER stored here; it is entered at runtime and kept in SecureStore.
EXPO_PUBLIC_API_BASE_URL=https://pornhwadb.com/api/v1

# Website origin used by the read-only Gallery screen (internal JSON endpoint).
EXPO_PUBLIC_SITE_BASE_URL=https://pornhwadb.com

# Reader website origin used for fetching webtoon chapter pages and deep-linking.
EXPO_PUBLIC_READER_BASE_URL=https://pornhwareader.com
