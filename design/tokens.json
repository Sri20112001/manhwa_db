{
  "$schema": "pornhwa-db/design-tokens@1",
  "meta": {
    "name": "Pornhwa DB Mobile",
    "typeface": "Inter",
    "sources": ["pornhwadb.com CSS variables (shadcn rose)", "Kotatsu-Redo AMOLED shell"]
  },
  "color": {
    "dark": {
      "background": "#000000",
      "surface": "#0B0B0B",
      "card": "#141414",
      "elevated": "#1C1C1F",
      "border": "#27272A",
      "foreground": "#FAFAFA",
      "mutedForeground": "#A1A1AA",
      "primary": "#9B3E64",
      "primaryHover": "#903C5F",
      "primarySoft": "rgba(155,62,100,0.14)",
      "onPrimary": "#FFFFFF",
      "destructive": "#DC2626",
      "success": "#059669",
      "warning": "#D97706",
      "info": "#2563EB",
      "ring": "#9B3E64"
    },
    "light": {
      "background": "#FAF1F3",
      "surface": "#FFF7F9",
      "card": "#FFFAFB",
      "elevated": "#F0E0E5",
      "border": "#E2CDD4",
      "foreground": "#422D38",
      "mutedForeground": "#795568",
      "primary": "#9B3E64",
      "primaryHover": "#903C5F",
      "primarySoft": "rgba(155,62,100,0.10)",
      "onPrimary": "#FFFFFF",
      "destructive": "#DC2626"
    },
    "status": {
      "ongoing": { "bg": "rgba(155,62,100,0.14)", "text": "#9B3E64" },
      "completed": { "bg": "#DCFCE7", "text": "#15803D" },
      "hiatus": { "bg": "#FEF3C7", "text": "#B45309" }
    },
    "chart": {
      "pink": "#DB2777", "violet": "#7C3AED", "blue": "#2563EB",
      "green": "#059669", "amber": "#D97706", "cyan": "#0891B2"
    }
  },
  "radius": { "sm": 6, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32 },
  "type": {
    "family": "Inter",
    "display": { "size": 28, "weight": 700, "lineHeight": 36 },
    "h1": { "size": 24, "weight": 700, "lineHeight": 32 },
    "h2": { "size": 20, "weight": 700, "lineHeight": 28 },
    "h3": { "size": 16, "weight": 600, "lineHeight": 24 },
    "body": { "size": 16, "weight": 400, "lineHeight": 24 },
    "caption": { "size": 13, "weight": 400, "lineHeight": 18 },
    "overline": { "size": 12, "weight": 600, "lineHeight": 16, "letterSpacing": 0.6 }
  },
  "cover": { "aspectRatio": "2/3", "radius": 12, "gap": 12 },
  "icons": { "family": "Lucide", "stroke": 1.75, "size": { "nav": 26, "action": 22, "inline": 18 } }
}
